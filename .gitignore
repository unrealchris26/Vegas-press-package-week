# Source material that lives in this working folder but is not part of the
# site: one-sheets, the photo shoot, the design reference. Keeping them out
# keeps the repo small and avoids publishing them by accident.
*.jpg
*.jpeg
*.png

# ...except the shipped backdrop plate.
!assets/*.png
!assets/*.webp

# Local env. Holds the GHL webhook URL, which is a bearer credential --
# anyone with it can write contacts into the CRM and spend premium-trigger
# budget. Never commit these.
.env
.env.*
!.env.example

# Vercel
.vercel/

# Node
node_modules/
npm-debug.log*

# OS
Thumbs.db
desktop.ini
.DS_Store
